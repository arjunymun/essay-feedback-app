{
  "name": "essay-feedback-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.mjs",
    "test:watch": "vitest --config vitest.config.mjs",
    "test:e2e": "playwright test",
    "supabase:verify": "node scripts/verify-supabase-schema.mjs",
    "portfolio:capture": "node scripts/capture-portfolio-assets.mjs",
    "review:test": "cd services/review-api && .venv\\Scripts\\python.exe -m pytest tests",
    "review:eval": "cd services/review-api && .venv\\Scripts\\python.exe -m review_api.evals"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.0",
    "@supabase/supabase-js": "^2.101.0",
    "date-fns": "^4.1.0",
    "lucide-react": "^1.7.0",
    "mammoth": "^1.12.0",
    "next": "^16.2.6",
    "openai": "^6.33.0",
    "pdf-parse": "^2.4.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "stripe": "^21.0.1",
    "three": "^0.181.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.181.0",
    "@vitest/coverage-v8": "^4.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.2"
  },
  "overrides": {
    "postcss": "^8.5.10"
  }
}
